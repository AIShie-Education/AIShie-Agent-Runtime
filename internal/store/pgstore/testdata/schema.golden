-- constraints
agent_state agent_state_pkey PRIMARY KEY (agent_id)
agent_token agent_token_pkey PRIMARY KEY (agent_id)
agent_token agent_token_secret_id_fkey FOREIGN KEY (secret_id) REFERENCES secret(id)
agent_token agent_token_secret_id_key UNIQUE (secret_id)
answer answer_pkey PRIMARY KEY (agent_id, id)
attempt attempt_pkey PRIMARY KEY (agent_id, key)
attempt attempt_state_known CHECK ((state = ANY (ARRAY['sending'::text, 'executed'::text, 'proposed'::text, 'failed'::text, 'denied'::text, 'error'::text, 'rejected'::text, 'cancelled'::text, 'changes_requested'::text]))) NOT VALID
audit audit_detail_object CHECK ((jsonb_typeof(detail) = 'object'::text))
audit audit_pkey PRIMARY KEY (id)
chat_approval chat_approval_conversation_id_fkey FOREIGN KEY (conversation_id) REFERENCES chat_conversation(id) ON DELETE CASCADE
chat_approval chat_approval_generation_id_fkey FOREIGN KEY (generation_id) REFERENCES chat_generation(id) ON DELETE CASCADE
chat_approval chat_approval_message_id_fkey FOREIGN KEY (message_id) REFERENCES chat_message(id) ON DELETE CASCADE
chat_approval chat_approval_mode_check CHECK ((mode = ANY (ARRAY['decision'::text, 'review'::text])))
chat_approval chat_approval_pkey PRIMARY KEY (id)
chat_approval chat_approval_state_check CHECK ((state = ANY (ARRAY['pending'::text, 'approved'::text, 'rejected'::text, 'changes_requested'::text, 'reviewed'::text, 'cancelled'::text])))
chat_approval chat_approval_subject_check CHECK ((subject = ANY (ARRAY['question'::text, 'answer'::text])))
chat_approval_action chat_approval_action_approval_id_fkey FOREIGN KEY (approval_id) REFERENCES chat_approval(id) ON DELETE CASCADE
chat_approval_action chat_approval_action_operation_check CHECK ((operation = ANY (ARRAY['decide'::text, 'review'::text])))
chat_approval_action chat_approval_action_pkey PRIMARY KEY (course_id, actor_id, key)
chat_attachment chat_attachment_check CHECK (((NOT (media_type ~~ 'image/%'::text)) OR (size <= 5242880)))
chat_attachment chat_attachment_check1 CHECK (((NOT (media_type ~~ 'text/%'::text)) OR (size <= 32768)))
chat_attachment chat_attachment_media_type_check CHECK (((media_type ~~ 'image/%'::text) OR (media_type ~~ 'text/%'::text)))
chat_attachment chat_attachment_message_id_fkey FOREIGN KEY (message_id) REFERENCES chat_message(id) ON DELETE CASCADE
chat_attachment chat_attachment_pkey PRIMARY KEY (id)
chat_attachment chat_attachment_size_check CHECK ((size >= 0))
chat_conversation chat_conversation_pkey PRIMARY KEY (id)
chat_conversation chat_conversation_revision_check CHECK ((revision > 0))
chat_conversation chat_conversation_state_check CHECK ((state = ANY (ARRAY['queued'::text, 'answering'::text, 'answered'::text, 'reply_pending_approval'::text, 'failed'::text, 'closed'::text])))
chat_draft chat_draft_conversation_id_fkey FOREIGN KEY (conversation_id) REFERENCES chat_conversation(id) ON DELETE CASCADE
chat_draft chat_draft_pkey PRIMARY KEY (conversation_id)
chat_draft chat_draft_steps_check CHECK ((jsonb_typeof(steps) = 'array'::text))
chat_draft chat_draft_version_check CHECK ((version > 0))
chat_generation chat_generation_answer_level_check CHECK ((answer_level = ANY (ARRAY['autonomous'::text, 'pending_review'::text, 'confirm_required'::text])))
chat_generation chat_generation_assistant_message_id_key UNIQUE (assistant_message_id)
chat_generation chat_generation_attempt_check CHECK ((attempt >= 0))
chat_generation chat_generation_conversation_id_fkey FOREIGN KEY (conversation_id) REFERENCES chat_conversation(id) ON DELETE CASCADE
chat_generation chat_generation_fence_check CHECK ((fence >= 0))
chat_generation chat_generation_pkey PRIMARY KEY (id)
chat_generation chat_generation_result_check CHECK (((result IS NULL) OR (jsonb_typeof(result) = 'object'::text)))
chat_generation chat_generation_state_check CHECK ((state = ANY (ARRAY['queued'::text, 'running'::text, 'proposed'::text, 'done'::text, 'failed'::text, 'cancelled'::text])))
chat_generation chat_generation_user_message_id_fkey FOREIGN KEY (user_message_id) REFERENCES chat_message(id) ON DELETE CASCADE
chat_idempotency chat_idempotency_conversation_id_fkey FOREIGN KEY (conversation_id) REFERENCES chat_conversation(id) ON DELETE CASCADE
chat_idempotency chat_idempotency_pkey PRIMARY KEY (course_id, actor_id, key)
chat_message chat_message_check CHECK (((status <> 'retracted'::text) OR (body = ''::text)))
chat_message chat_message_conversation_id_fkey FOREIGN KEY (conversation_id) REFERENCES chat_conversation(id) ON DELETE CASCADE
chat_message chat_message_conversation_id_seq_key UNIQUE (conversation_id, seq)
chat_message chat_message_pkey PRIMARY KEY (id)
chat_message chat_message_role_check CHECK ((role = ANY (ARRAY['user'::text, 'assistant'::text])))
chat_message chat_message_seq_check CHECK ((seq > 0))
chat_message chat_message_sources_check CHECK (((sources IS NULL) OR (jsonb_typeof(sources) = 'array'::text)))
chat_message chat_message_status_check CHECK ((status = ANY (ARRAY['posted'::text, 'pending'::text, 'retracted'::text, 'failed'::text])))
chat_message chat_message_usage_check CHECK (((usage IS NULL) OR (jsonb_typeof(usage) = 'object'::text)))
cursor cursor_pkey PRIMARY KEY (agent_id, member_id, kind)
hosted_agent hosted_agent_core_actor_id_key UNIQUE (core_actor_id)
hosted_agent hosted_agent_id_shape CHECK ((id ~ '^agt_[A-Za-z0-9_-]{1,60}$'::text))
hosted_agent hosted_agent_key_secret_id_fkey FOREIGN KEY (key_secret_id) REFERENCES secret(id)
hosted_agent hosted_agent_key_secret_id_key UNIQUE (key_secret_id)
hosted_agent hosted_agent_pkey PRIMARY KEY (id)
hosted_agent hosted_agent_settings_object CHECK ((jsonb_typeof(settings) = 'object'::text))
hosted_agent hosted_agent_token_issued CHECK (((token_secret_id IS NOT NULL) OR ((NOT token_issued) AND (token_credential_id = ''::text) AND (token_hint = ''::text))))
hosted_agent hosted_agent_token_secret_id_fkey FOREIGN KEY (token_secret_id) REFERENCES secret(id)
hosted_agent hosted_agent_token_secret_id_key UNIQUE (token_secret_id)
hosted_agent hosted_agent_two_secrets CHECK (((key_secret_id IS NULL) OR (key_secret_id IS DISTINCT FROM token_secret_id)))
hosted_course hosted_course_agent_id_fkey FOREIGN KEY (agent_id) REFERENCES hosted_agent(id) ON DELETE CASCADE
hosted_course hosted_course_pkey PRIMARY KEY (agent_id, course_id)
hosted_course hosted_course_settings_object CHECK ((jsonb_typeof(settings) = 'object'::text))
lease lease_pkey PRIMARY KEY (name)
llm_call llm_call_pkey PRIMARY KEY (agent_id, id)
note note_pkey PRIMARY KEY (id)
ocr_text ocr_text_kind_check CHECK ((kind = ANY (ARRAY['pdf'::text, 'image'::text])))
ocr_text ocr_text_pages_check CHECK ((pages >= 0))
ocr_text ocr_text_pages_of_check CHECK ((pages_of >= 0))
ocr_text ocr_text_pkey PRIMARY KEY (sum)
ocr_text ocr_text_status_check CHECK ((status = ANY (ARRAY['done'::text, 'failed'::text])))
ocr_text ocr_text_sum_check CHECK ((sum ~ '^sha256:[0-9a-f]{64}$'::text))
person person_pkey PRIMARY KEY (core_actor_id)
registry_rev registry_rev_one_row CHECK (one)
registry_rev registry_rev_pkey PRIMARY KEY (one)
school_offer school_offer_id_shape CHECK ((id ~ '^[A-Za-z0-9_-]{1,64}$'::text))
school_offer school_offer_key_secret_id_fkey FOREIGN KEY (key_secret_id) REFERENCES secret(id)
school_offer school_offer_key_secret_id_key UNIQUE (key_secret_id)
school_offer school_offer_openrouter_object CHECK (((openrouter IS NULL) OR (jsonb_typeof(openrouter) = 'object'::text)))
school_offer school_offer_openrouter_provider CHECK (((openrouter IS NULL) OR (provider = 'openrouter'::text)))
school_offer school_offer_output_bound CHECK ((max_output_tokens >= 0))
school_offer school_offer_pkey PRIMARY KEY (id)
search_file search_file_length_check CHECK ((length >= 0))
search_file search_file_passages_check CHECK ((passages >= 0))
search_file search_file_pkey PRIMARY KEY (version_id, file_key)
search_file search_file_position_check CHECK (("position" >= 0))
search_file search_file_source_check CHECK ((source = ANY (ARRAY['staff'::text, 'ai'::text, 'runtime'::text, 'body'::text])))
search_passage search_passage_length_check CHECK ((length >= 0))
search_passage search_passage_part_check CHECK ((part >= 1))
search_passage search_passage_pkey PRIMARY KEY (version_id, file_key, seq)
search_passage search_passage_section_n_check CHECK ((section_n >= 0))
search_passage search_passage_seq_check CHECK ((seq >= 0))
search_passage search_passage_start_offset_check CHECK ((start_offset >= 0))
search_passage search_passage_version_id_file_key_fkey FOREIGN KEY (version_id, file_key) REFERENCES search_file(version_id, file_key) ON DELETE CASCADE
seat seat_pkey PRIMARY KEY (agent_id, member_id)
secret secret_id_shape CHECK ((id ~ '^sec_[A-Za-z0-9_-]{1,60}$'::text))
secret secret_kind_known CHECK ((kind = ANY (ARRAY['core_token'::text, 'model_key'::text])))
secret secret_pkey PRIMARY KEY (id)
site_price site_price_id_shape CHECK ((id ~ '^[A-Za-z0-9._-]{1,64}$'::text))
site_price site_price_model_given CHECK ((btrim(model) <> ''::text))
site_price site_price_not_negative CHECK (((input_pusd >= 0) AND (cache_read_pusd >= 0) AND (cache_write_pusd >= 0) AND (output_pusd >= 0)))
site_price site_price_one_per_day UNIQUE (provider, model, from_day)
site_price site_price_pkey PRIMARY KEY (id)
site_price site_price_provider_shape CHECK ((provider ~ '^[a-z0-9_]+$'::text))
site_price_rev site_price_rev_one_row CHECK (one)
site_price_rev site_price_rev_pkey PRIMARY KEY (one)
site_setting site_setting_name_shape CHECK ((name ~ '^[a-z][a-z0-9_]{0,63}$'::text))
site_setting site_setting_pkey PRIMARY KEY (name)
site_setting site_setting_value_object CHECK ((jsonb_typeof(value) = 'object'::text))
site_tenant_quota site_tenant_quota_pkey PRIMARY KEY (tenant_id)
site_tenant_quota site_tenant_quota_positive CHECK ((((answers IS NULL) OR (answers >= 1)) AND ((usd_pusd IS NULL) OR (usd_pusd >= 1))))
site_tenant_quota site_tenant_quota_tenant_shape CHECK ((tenant_id ~ '^[A-Za-z0-9_-]{1,64}$'::text))
transcription_credential transcription_credential_one_row CHECK (one)
transcription_credential transcription_credential_pkey PRIMARY KEY (one)
transcription_credential transcription_credential_secret_id_fkey FOREIGN KEY (secret_id) REFERENCES secret(id)
transcription_credential transcription_credential_secret_id_key UNIQUE (secret_id)
transcription_job transcription_job_id_shape CHECK ((id ~ '^trj_'::text))
transcription_job transcription_job_pkey PRIMARY KEY (id)
transcription_job transcription_job_seq_key UNIQUE (seq)
transcription_job transcription_job_status_known CHECK ((status = ANY (ARRAY['working'::text, 'done'::text, 'failed'::text, 'skipped'::text, 'dropped'::text])))
-- indexes
