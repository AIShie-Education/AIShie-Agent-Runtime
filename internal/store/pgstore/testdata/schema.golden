-- constraints
agent_state agent_state_pkey PRIMARY KEY (agent_id)
agent_token agent_token_pkey PRIMARY KEY (agent_id)
agent_token agent_token_secret_id_fkey FOREIGN KEY (secret_id) REFERENCES secret(id)
agent_token agent_token_secret_id_key UNIQUE (secret_id)
answer answer_pkey PRIMARY KEY (agent_id, id)
attempt attempt_pkey PRIMARY KEY (agent_id, key)
attempt attempt_state_known CHECK ((state = ANY (ARRAY['sending'::text, 'executed'::text, 'proposed'::text, 'failed'::text, 'denied'::text, 'error'::text, 'rejected'::text, 'cancelled'::text])))
audit audit_detail_object CHECK ((jsonb_typeof(detail) = 'object'::text))
audit audit_pkey PRIMARY KEY (id)
cursor cursor_pkey PRIMARY KEY (agent_id, member_id, kind)
hosted_agent hosted_agent_core_actor_id_key UNIQUE (core_actor_id)
hosted_agent hosted_agent_id_shape CHECK ((id ~ '^agt_[A-Za-z0-9_-]{1,60}$'::text))
hosted_agent hosted_agent_key_secret_id_fkey FOREIGN KEY (key_secret_id) REFERENCES secret(id)
hosted_agent hosted_agent_key_secret_id_key UNIQUE (key_secret_id)
hosted_agent hosted_agent_pkey PRIMARY KEY (id)
hosted_agent hosted_agent_settings_object CHECK ((jsonb_typeof(settings) = 'object'::text))
hosted_agent hosted_agent_token_issued CHECK (((token_secret_id IS NOT NULL) OR ((NOT token_issued) AND (token_credential_id = ''::text) AND (token_hint = ''::text))))
hosted_agent hosted_agent_token_secret_id_fkey FOREIGN KEY (token_secret_id) REFERENCES secret(id)
hosted_agent hosted_agent_token_secret_id_key UNIQUE (token_secret_id)
hosted_agent hosted_agent_two_secrets CHECK (((key_secret_id IS NULL) OR (key_secret_id IS DISTINCT FROM token_secret_id)))
hosted_course hosted_course_agent_id_fkey FOREIGN KEY (agent_id) REFERENCES hosted_agent(id) ON DELETE CASCADE
hosted_course hosted_course_pkey PRIMARY KEY (agent_id, course_id)
hosted_course hosted_course_settings_object CHECK ((jsonb_typeof(settings) = 'object'::text))
lease lease_pkey PRIMARY KEY (name)
llm_call llm_call_pkey PRIMARY KEY (agent_id, id)
note note_pkey PRIMARY KEY (id)
ocr_text ocr_text_kind_check CHECK ((kind = ANY (ARRAY['pdf'::text, 'image'::text])))
ocr_text ocr_text_pages_check CHECK ((pages >= 0))
ocr_text ocr_text_pages_of_check CHECK ((pages_of >= 0))
ocr_text ocr_text_pkey PRIMARY KEY (sum)
ocr_text ocr_text_status_check CHECK ((status = ANY (ARRAY['done'::text, 'failed'::text])))
ocr_text ocr_text_sum_check CHECK ((sum ~ '^sha256:[0-9a-f]{64}$'::text))
person person_pkey PRIMARY KEY (core_actor_id)
registry_rev registry_rev_one_row CHECK (one)
registry_rev registry_rev_pkey PRIMARY KEY (one)
school_offer school_offer_id_shape CHECK ((id ~ '^[A-Za-z0-9_-]{1,64}$'::text))
school_offer school_offer_key_secret_id_fkey FOREIGN KEY (key_secret_id) REFERENCES secret(id)
school_offer school_offer_key_secret_id_key UNIQUE (key_secret_id)
school_offer school_offer_output_bound CHECK ((max_output_tokens >= 0))
school_offer school_offer_pkey PRIMARY KEY (id)
seat seat_pkey PRIMARY KEY (agent_id, member_id)
secret secret_id_shape CHECK ((id ~ '^sec_[A-Za-z0-9_-]{1,60}$'::text))
secret secret_kind_known CHECK ((kind = ANY (ARRAY['core_token'::text, 'model_key'::text])))
secret secret_pkey PRIMARY KEY (id)
site_price site_price_id_shape CHECK ((id ~ '^[A-Za-z0-9._-]{1,64}$'::text))
site_price site_price_model_given CHECK ((btrim(model) <> ''::text))
site_price site_price_not_negative CHECK (((input_pusd >= 0) AND (cache_read_pusd >= 0) AND (cache_write_pusd >= 0) AND (output_pusd >= 0)))
site_price site_price_one_per_day UNIQUE (provider, model, from_day)
site_price site_price_pkey PRIMARY KEY (id)
site_price site_price_provider_shape CHECK ((provider ~ '^[a-z0-9_]+$'::text))
site_price_rev site_price_rev_one_row CHECK (one)
site_price_rev site_price_rev_pkey PRIMARY KEY (one)
site_setting site_setting_name_shape CHECK ((name ~ '^[a-z][a-z0-9_]{0,63}$'::text))
site_setting site_setting_pkey PRIMARY KEY (name)
site_setting site_setting_value_object CHECK ((jsonb_typeof(value) = 'object'::text))
site_tenant_quota site_tenant_quota_pkey PRIMARY KEY (tenant_id)
site_tenant_quota site_tenant_quota_positive CHECK ((((answers IS NULL) OR (answers >= 1)) AND ((usd_pusd IS NULL) OR (usd_pusd >= 1))))
site_tenant_quota site_tenant_quota_tenant_shape CHECK ((tenant_id ~ '^[A-Za-z0-9_-]{1,64}$'::text))
transcription_credential transcription_credential_one_row CHECK (one)
transcription_credential transcription_credential_pkey PRIMARY KEY (one)
transcription_credential transcription_credential_secret_id_fkey FOREIGN KEY (secret_id) REFERENCES secret(id)
transcription_credential transcription_credential_secret_id_key UNIQUE (secret_id)
transcription_job transcription_job_id_shape CHECK ((id ~ '^trj_'::text))
transcription_job transcription_job_pkey PRIMARY KEY (id)
transcription_job transcription_job_seq_key UNIQUE (seq)
transcription_job transcription_job_status_known CHECK ((status = ANY (ARRAY['working'::text, 'done'::text, 'failed'::text, 'skipped'::text, 'dropped'::text])))
-- indexes
CREATE UNIQUE INDEX agent_state_pkey ON public.agent_state USING btree (agent_id)
CREATE UNIQUE INDEX agent_token_pkey ON public.agent_token USING btree (agent_id)
CREATE UNIQUE INDEX agent_token_secret_id_key ON public.agent_token USING btree (secret_id)
CREATE INDEX answer_agent_course_idx ON public.answer USING btree (agent_id, course_id, at)
CREATE INDEX answer_agent_idx ON public.answer USING btree (agent_id, at)
CREATE INDEX answer_asker_idx ON public.answer USING btree (course_id, opener_member_id, at)
CREATE INDEX answer_at_idx ON public.answer USING btree (at)
CREATE UNIQUE INDEX answer_pkey ON public.answer USING btree (agent_id, id)
CREATE INDEX answer_tenant_idx ON public.answer USING btree (tenant_id, at)
CREATE INDEX attempt_action_idx ON public.attempt USING btree (agent_id, action_id) WHERE (action_id IS NOT NULL)
CREATE INDEX attempt_member_state_idx ON public.attempt USING btree (agent_id, member_id, state)
CREATE INDEX attempt_message_idx ON public.attempt USING btree (agent_id, conversation_id, message_id)
CREATE UNIQUE INDEX attempt_pkey ON public.attempt USING btree (agent_id, key)
CREATE INDEX audit_actor_idx ON public.audit USING btree (actor_id, at)
CREATE INDEX audit_at_idx ON public.audit USING btree (at)
CREATE UNIQUE INDEX audit_pkey ON public.audit USING btree (id)
CREATE INDEX audit_target_idx ON public.audit USING btree (target_type, target_id, at)
CREATE UNIQUE INDEX cursor_pkey ON public.cursor USING btree (agent_id, member_id, kind)
CREATE UNIQUE INDEX hosted_agent_core_actor_id_key ON public.hosted_agent USING btree (core_actor_id)
CREATE UNIQUE INDEX hosted_agent_key_secret_id_key ON public.hosted_agent USING btree (key_secret_id)
CREATE INDEX hosted_agent_owner_idx ON public.hosted_agent USING btree (owner_actor_id)
CREATE UNIQUE INDEX hosted_agent_pkey ON public.hosted_agent USING btree (id)
CREATE UNIQUE INDEX hosted_agent_token_secret_id_key ON public.hosted_agent USING btree (token_secret_id)
CREATE UNIQUE INDEX hosted_course_pkey ON public.hosted_course USING btree (agent_id, course_id)
CREATE UNIQUE INDEX lease_pkey ON public.lease USING btree (name)
CREATE INDEX llm_call_agent_course_idx ON public.llm_call USING btree (agent_id, course_id, at)
CREATE INDEX llm_call_agent_idx ON public.llm_call USING btree (agent_id, at)
CREATE INDEX llm_call_asker_idx ON public.llm_call USING btree (course_id, opener_member_id, at)
CREATE INDEX llm_call_at_idx ON public.llm_call USING btree (at)
CREATE UNIQUE INDEX llm_call_pkey ON public.llm_call USING btree (agent_id, id)
CREATE INDEX llm_call_tenant_idx ON public.llm_call USING btree (tenant_id, at)
CREATE INDEX note_conversation_idx ON public.note USING btree (agent_id, member_id, conversation_id, created_at)
CREATE UNIQUE INDEX note_pkey ON public.note USING btree (id)
CREATE INDEX ocr_text_by_age ON public.ocr_text USING btree (status, created_at)
CREATE UNIQUE INDEX ocr_text_pkey ON public.ocr_text USING btree (sum)
CREATE UNIQUE INDEX person_pkey ON public.person USING btree (core_actor_id)
CREATE UNIQUE INDEX registry_rev_pkey ON public.registry_rev USING btree (one)
CREATE UNIQUE INDEX school_offer_key_secret_id_key ON public.school_offer USING btree (key_secret_id)
CREATE UNIQUE INDEX school_offer_pkey ON public.school_offer USING btree (id)
CREATE INDEX seat_gone_idx ON public.seat USING btree (gone_at) WHERE (gone_at IS NOT NULL)
CREATE UNIQUE INDEX seat_pkey ON public.seat USING btree (agent_id, member_id)
CREATE INDEX secret_kek_idx ON public.secret USING btree (kek_id)
CREATE UNIQUE INDEX secret_pkey ON public.secret USING btree (id)
CREATE INDEX secret_tenant_idx ON public.secret USING btree (tenant_id)
CREATE UNIQUE INDEX site_price_one_per_day ON public.site_price USING btree (provider, model, from_day)
CREATE UNIQUE INDEX site_price_pkey ON public.site_price USING btree (id)
CREATE UNIQUE INDEX site_price_rev_pkey ON public.site_price_rev USING btree (one)
CREATE UNIQUE INDEX site_setting_pkey ON public.site_setting USING btree (name)
CREATE UNIQUE INDEX site_tenant_quota_pkey ON public.site_tenant_quota USING btree (tenant_id)
CREATE UNIQUE INDEX transcription_credential_pkey ON public.transcription_credential USING btree (one)
CREATE UNIQUE INDEX transcription_credential_secret_id_key ON public.transcription_credential USING btree (secret_id)
CREATE UNIQUE INDEX transcription_job_pkey ON public.transcription_job USING btree (id)
CREATE UNIQUE INDEX transcription_job_seq_key ON public.transcription_job USING btree (seq)
CREATE INDEX transcription_job_started_idx ON public.transcription_job USING btree (started_at)
CREATE INDEX transcription_job_status_idx ON public.transcription_job USING btree (status, seq)
-- triggers
CREATE TRIGGER hosted_agent_changed AFTER INSERT OR DELETE OR UPDATE OR TRUNCATE ON public.hosted_agent FOR EACH STATEMENT EXECUTE FUNCTION registry_changed()
CREATE TRIGGER hosted_course_changed AFTER INSERT OR DELETE OR UPDATE OR TRUNCATE ON public.hosted_course FOR EACH STATEMENT EXECUTE FUNCTION registry_changed()
CREATE TRIGGER school_offer_changed AFTER INSERT OR DELETE OR UPDATE OR TRUNCATE ON public.school_offer FOR EACH STATEMENT EXECUTE FUNCTION registry_changed()
CREATE TRIGGER site_price_changed AFTER INSERT OR DELETE OR UPDATE OR TRUNCATE ON public.site_price FOR EACH STATEMENT EXECUTE FUNCTION registry_changed()
CREATE TRIGGER site_price_versioned AFTER INSERT OR DELETE OR UPDATE OR TRUNCATE ON public.site_price FOR EACH STATEMENT EXECUTE FUNCTION site_price_changed()
CREATE TRIGGER site_setting_changed AFTER INSERT OR DELETE OR UPDATE OR TRUNCATE ON public.site_setting FOR EACH STATEMENT EXECUTE FUNCTION registry_changed()
CREATE TRIGGER site_tenant_quota_changed AFTER INSERT OR DELETE OR UPDATE OR TRUNCATE ON public.site_tenant_quota FOR EACH STATEMENT EXECUTE FUNCTION registry_changed()
CREATE TRIGGER transcription_credential_changed AFTER INSERT OR DELETE OR TRUNCATE ON public.transcription_credential FOR EACH STATEMENT EXECUTE FUNCTION registry_changed()
CREATE TRIGGER transcription_credential_replaced AFTER UPDATE OF secret_id ON public.transcription_credential FOR EACH STATEMENT EXECUTE FUNCTION registry_changed()
