{
  "name": "@aishie/agent-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Loopback-only AIShie model and MCP runner",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "dev:chat": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.149",
    "@ai-sdk/anthropic": "^4.0.110",
    "@ai-sdk/google": "^4.0.128",
    "@ai-sdk/mcp": "^2.0.106",
    "@ai-sdk/openai": "^4.0.125",
    "@ai-sdk/openai-compatible": "^3.0.68",
    "ai": "^7.0.183",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "undici": "^7.24.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
